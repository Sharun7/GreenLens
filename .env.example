# .env.example — copy this to .env and fill in your values
# (never commit the real .env to source control)

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (individual vars — used for local dev when DATABASE_URL is absent)
DB_NAME=greenlens_db
DB_USER=greenlens_user
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# ── Database (single URL — used by Render / Docker / Heroku)
# IMPORTANT: use postgresql:// NOT postgis:// — postgis:// loads GDAL at startup
# Render sets this automatically; uncomment only for Docker-based local dev.
# DATABASE_URL=postgresql://greenlens_user:your_password@localhost:5432/greenlens_db

# ── Redis / Celery ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Google Earth Engine ───────────────────────────────────────────────────────
EE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
EE_PRIVATE_KEY_FILE=path/to/privatekey.json
EE_PROJECT_ID=your-gee-project-id

# ── NASA Earthdata ────────────────────────────────────────────────────────────
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# ── Financial Data ────────────────────────────────────────────────────────────
YAHOO_FINANCE_API_KEY=optional_if_using_premium

# ── Email (optional, for alerts) ──────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=GreenLens <noreply@greenlens.io>

# ── Render deployment ─────────────────────────────────────────────────────────
RENDER_EXTERNAL_HOSTNAME=your-app.onrender.com
