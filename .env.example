# GreenLens Environment Variables
# Copy this file to .env and fill in your actual values

# ── Django Core ────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-generate-with-django
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# For Render deployment (optional)
RENDER_EXTERNAL_HOSTNAME=your-app.onrender.com

# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection (use DATABASE_URL or individual settings)
DATABASE_URL=postgresql://user:password@localhost:5432/greenlens_db

# OR use individual settings:
DB_NAME=greenlens_db
DB_USER=greenlens_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ── Celery & Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/2
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Google Earth Engine ────────────────────────────────────────────────────────
# Service account credentials for satellite imagery
EE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
EE_PRIVATE_KEY_FILE=/path/to/your-gee-credentials.json
EE_PROJECT_ID=your-gee-project-id

# ── NASA Earthdata ─────────────────────────────────────────────────────────────
# For climate hazard data (CCKP, NEX-GDDP)
EARTHDATA_USERNAME=your-nasa-earthdata-username
EARTHDATA_PASSWORD=your-nasa-earthdata-password

# ── Optional: Email Configuration ──────────────────────────────────────────────
# For sending monitoring reports (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=noreply@greenlens.com
MONITORING_EMAIL_RECIPIENTS=admin@example.com,team@example.com

# ── Optional: External APIs ────────────────────────────────────────────────────
# Yahoo Finance (usually no auth needed, but can set proxy if required)
# YAHOO_FINANCE_PROXY=http://proxy:port

# World Bank API (no auth needed, but can set custom endpoint)
# WORLD_BANK_API_URL=https://climateknowledgeportal.worldbank.org/api
